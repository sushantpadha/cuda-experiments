# Ignore everything by default
*

# Keep directories traversable
!*/

# -------------------------
# Source code
# -------------------------
!*.cu
!*.cuh
!*.cpp
!*.cc
!*.c
!*.h
!*.hpp
!*.py
!*.pyw
!*.sh
!*.bash
!*.zsh
!*.fish
!*.pl
!*.lua
!*.rs
!*.go
!*.java

# -------------------------
# Build / project files
# -------------------------
!Makefile
!makefile
!CMakeLists.txt
!*.cmake
!*.mk
!*.toml
!*.yaml
!*.yml
!*.json
!*.ini
!*.cfg
!*.conf

# -------------------------
# Documentation / notes
# -------------------------
!*.md
!*.txt
!*.rst
!*.tex
!*.bib
!*.sty

# Only the built report is tracked; every other PDF (papers, slides, manuals) stays local.
!report/report.pdf

# -------------------------
# Notebooks
# -------------------------
!*.ipynb

# -------------------------
# Git
# -------------------------
!.gitignore
!.gitattributes

# Local tool state (never tracked)
.claude
.serena
.vscode

# Generated / local-only
generated_tests/
HANDOFF.md
